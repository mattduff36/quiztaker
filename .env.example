# Neon database and Managed Auth
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/database?sslmode=require
NEON_AUTH_BASE_URL=https://your-auth-host.neonauth.region.aws.neon.tech/database/auth
NEON_AUTH_COOKIE_SECRET=replace_with_at_least_32_random_characters
ALLOWED_EMAIL=operator@example.com
HELPER_MASTER_KEY=replace_with_at_least_32_random_characters
# Dedicated base64-encoded 32-byte key for per-user AI credentials (AES-256-GCM).
# Keep stable and back up securely; changing it requires reconnecting saved providers.
LLM_CREDENTIAL_KEY=replace_with_base64_encoded_32_random_bytes

# Vercel supplies OIDC credentials automatically when a private Blob store is
# connected. Use a token only for local artifact upload/download testing.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
NEXT_PUBLIC_SITE_URL=https://vitriol.co.uk
GITHUB_REPOSITORY=mattduff36/quiztaker

# Set to 0 to keep legacy operation cards while rejecting new parity actions.
PARITY_NEW_ACTIONS=1

# Optional OpenAI-compatible key for the quiz learner. Leave unset to keep Learn quiz disabled.
# LEARNER_API_KEY=
# LEARNER_BASE_URL=https://api.openai.com/v1
# LEARNER_MODEL=gpt-4o-mini
# Comma-separated backups, tried in order when the preferred model is busy.
# Gemini defaults, when this is unset, are the free text models:
# gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash, gemini-3-flash-preview,
# gemini-2.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-2.5-flash-lite.
# LEARNER_MODELS=
# Local runs use Cursor first, so Gemini quota stays unused while developing.
# Create a key at https://cursor.com/dashboard/integrations
# CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5

# apps/helper (development overrides)
QUIZTAKER_HOME=C:\Users\you\AppData\Local\QuizTaker Helper
QUIZTAKER_AUTOMATION_ROOT=C:\path\to\quiztaker
PLAYWRIGHT_CDP_PORT=9222
