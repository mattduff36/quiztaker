{
  "name": "quiztaker",
  "version": "1.0.0",
  "description": "Vitriol hosted control plane and local Windows helper for Saba learning automation.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "index.js",
  "scripts": {
    "start": "npm run start --workspace=@quiztaker/web",
    "dev": "npm run dev --workspace=@quiztaker/web",
    "dev:web": "npm run dev --workspace=@quiztaker/web",
    "dev:helper": "npm run dev --workspace=@quiztaker/helper",
    "start:legacy": "node server.js",
    "dev:legacy": "node --watch server.js --port 4000",
    "build": "node --env-file-if-exists=.env.local scripts/build-workspaces.mjs",
    "typecheck": "npm run build --workspace=@quiztaker/core && npm run typecheck --workspaces --if-present",
    "test": "node --test *.test.js && npm run test --workspaces --if-present",
    "test:db": "node --env-file=.env.local scripts/verify-neon.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate-neon.mjs",
    "import:legacy": "node --env-file-if-exists=.env.local scripts/import-legacy-knowledge.mjs",
    "test:parity": "node scripts/parity-headed.mjs",
    "test:e2e": "playwright test --project=headless",
    "test:e2e:headed": "playwright test --project=headed",
    "migrate:learning": "node migrate-learning-data.js",
    "release:helper": "npm run package:win --workspace=@quiztaker/helper"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.19.0",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "postgres": "^3.4.7",
    "minimatch": "file:vendor/minimatch-compat",
    "fast-glob": "file:vendor/next-glob"
  },
  "overrides": {
    "@better-auth/passkey": "1.7.15",
    "@better-auth/core": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
    "better-auth": "1.7.15",
    "better-call": "1.4.4",
    "@better-fetch/fetch": "1.3.3",
    "zod": "4.6.7",
    "@vercel/oidc": "4.0.6",
    "@react-email/render": "2.2.0",
    "next": "16.4.4",
    "postcss-selector-parser": "7.1.6",
    "proxy-addr": "2.0.8",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "minimatch": "$minimatch",
    "fast-glob": "$fast-glob"
  }
}
